# Gotenberg — переменные окружения
# ВНИМАНИЕ: не коммитить в git. Права: chmod 600

# Порт хоста, на котором Gotenberg слушает (внутри контейнера всегда 3000)
GOTENBERG_HOST_PORT=3102

# Адрес привязки на хосте. 127.0.0.1 = только локальный доступ.
GOTENBERG_BIND_IP=127.0.0.1

# Таймаут обработки запроса (нужен для документов с JavaScript)
API_TIMEOUT=60s

# Максимальный размер тела multipart/form-data (входного HTML + ассетов)
API_BODY_LIMIT=50MB

# Уровень логирования: error | warn | info | debug
LOG_LEVEL=info
